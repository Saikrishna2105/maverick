{
  "name": "maverick-drive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Maverick Drive - a realistic 3D city driving simulator that runs in the browser",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=build/game.js",
    "dev": "esbuild src/main.js --bundle --format=iife --sourcemap --outfile=build/game.js --watch --servedir=."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.187.0"
  }
}
